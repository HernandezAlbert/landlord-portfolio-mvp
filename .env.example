# Postgres (local or hosted)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/landlord_portfolio?schema=public"

# Auth
AUTH_SECRET="replace-with-strong-random-32+chars"

# Single user credentials used by seed script
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="ChangeMe!123"

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Landlord Portfolio <noreply@yourdomain.com>"
EMAIL_TO="you@example.com"
APP_BASE_URL="http://localhost:3000"

# Vercel cron protection
CRON_SECRET="replace-with-random"

# Google Sheets service account JSON for Google Form response imports
GOOGLE_SERVICE_ACCOUNT_JSON="{...}"
