generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  settings            UserSettings?
  properties          Property[]
  tenants             Tenant[]
  applicants          Applicant[]
  passwordResetTokens PasswordResetToken[]
  actionOverrides     ActionOverride[]
}

model UserSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  digestEmailTo  String?
  emailFromName  String?
  replyToEmail   String?
  digestEnabled  Boolean  @default(true)
  timezone       String   @default("Europe/London")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Property {
  id                         String    @id @default(cuid())
  userId                     String
  name                       String
  address1                   String
  address2                   String?
  city                       String
  postcode                   String
  notes                      String?
  googleFormImportEnabled    Boolean   @default(false)
  googleSheetId              String?
  googleSheetTabName         String?
  googleLastImportedRow      Int?
  googleLastCheckedAt        DateTime?
  googleLastImportedAt       DateTime?
  googleSyncError            String?
  screeningPassMultiplier    Float     @default(3.0)
  screeningGuarantorMinMultiplier Float @default(2.0)
  advertisedRentMonthly      Int?
  propertyLicenseExpiresOn   DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicants       Applicant[]
  compliance       ComplianceItem[]
  expenses         Expense[]
  inspections      Inspection[]
  insurancePolicy  InsurancePolicy?
  mortgage         MortgageDetail?
  tenancies        Tenancy[]
  reportSchedules  ReportSchedule[]
  reportRuns       ReportRun[]
  holdingDeposits  HoldingDeposit[]

  @@index([userId])
  @@index([deletedAt])
  @@index([googleFormImportEnabled])
  @@index([propertyLicenseExpiresOn])
}

model Tenant {
  id                    String    @id @default(cuid())
  userId                String
  fullName              String
  email                 String?
  phone                 String?
  notes                 String?
  rightToRentExpiresOn  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactLogs ContactLog[]
  tenancies   TenancyTenant[]

  @@index([userId])
  @@index([deletedAt])
  @@index([rightToRentExpiresOn])
}

model Tenancy {
  id                     String        @id @default(cuid())
  propertyId             String
  startDate              DateTime
  endDate                DateTime?
  rentMonthly            Int
  rentAmount             Int           @default(0)
  rentFrequency          RentFrequency @default(MONTHLY)
  rentDueDay             Int
  isActive               Boolean       @default(true)
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  autoGenerateRent       Boolean   @default(true)
  lastRentGeneratedOn    DateTime?
  rentGenerateMonthsAhead Int      @default(3)

  contactLogs ContactLog[]
  expenses    Expense[]
  notices     Notice[]
  payments    Payment[]
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants     TenancyTenant[]

  @@index([propertyId])
  @@index([isActive])
  @@index([deletedAt])
}

model TenancyTenant {
  tenancyId String
  tenantId  String
  role      String?
  createdAt DateTime @default(now())

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenancyId, tenantId])
}

model Payment {
  id         String    @id @default(cuid())
  tenancyId  String
  dueDate    DateTime
  amountDue  Int
  amountPaid Int       @default(0)
  paidDate   DateTime?
  method     String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([tenancyId, dueDate])
  @@index([paidDate])
  @@index([deletedAt])
}

model ComplianceItem {
  id         String         @id @default(cuid())
  propertyId String
  type       ComplianceType
  lastDone   DateTime?
  expiresOn  DateTime?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, type])
  @@index([expiresOn])
  @@index([deletedAt])
}

model Inspection {
  id         String    @id @default(cuid())
  propertyId String
  lastDate   DateTime?
  nextDue    DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([nextDue])
  @@index([deletedAt])
}

model Notice {
  id         String       @id @default(cuid())
  tenancyId  String
  type       NoticeType
  dateServed DateTime
  method     NoticeMethod
  notes      String?
  createdAt  DateTime     @default(now())
  deletedAt  DateTime?

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Cascade)

  @@index([tenancyId, dateServed])
  @@index([deletedAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String?
  text      String?
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DocumentStorageSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReminderConfig {
  id            String   @id @default(cuid())
  enabled       Boolean  @default(true)
  dailyEnabled  Boolean  @default(true)
  weeklyEnabled Boolean  @default(true)
  dailyTimeUtc  String   @default("08:00")
  weeklyDay     Int      @default(1)
  weeklyTimeUtc String   @default("08:00")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MortgageDetail {
  id                String    @id @default(cuid())
  propertyId        String    @unique
  lender            String?
  mortgageNumber    String?
  productName       String?
  productType       String?
  interestRate      Float?
  monthlyPayment    Int?
  productStartDate  DateTime?
  productEndDate    DateTime?
  mortgageTermStart DateTime?
  mortgageTermEnd   DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([productEndDate])
  @@index([deletedAt])
}

model InsurancePolicy {
  id           String    @id @default(cuid())
  propertyId   String    @unique
  provider     String?
  policyNumber String?
  coverType    String?
  annualPremium Int?
  monthlyPremium Int?
  startDate    DateTime?
  endDate      DateTime?
  renewalDate  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([renewalDate])
  @@index([deletedAt])
}

model Expense {
  id                   String    @id @default(cuid())
  propertyId           String
  tenancyId            String?
  date                 DateTime
  amount               Int
  category             ExpenseCategory
  vendor               String?
  reference            String?
  notes                String?
  receiptPath          String?
  receiptStoragePath   String?
  receiptOriginalName  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancy  Tenancy? @relation(fields: [tenancyId], references: [id])

  @@index([propertyId, date])
  @@index([tenancyId])
  @@index([deletedAt])
}

model ContactLog {
  id           String    @id @default(cuid())
  tenancyId    String?
  tenantId     String?
  type         ContactType
  date         DateTime
  subject      String?
  notes        String
  nextFollowUp DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenancy Tenancy? @relation(fields: [tenancyId], references: [id])
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenancyId, date])
  @@index([tenantId, date])
  @@index([nextFollowUp])
  @@index([deletedAt])
}

model Applicant {
  id                         String                     @id @default(cuid())
  userId                     String
  fullName                   String
  email                      String?
  phone                      String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  adults                     Int                        @default(1)
  children                   Int                        @default(0)
  deletedAt                  DateTime?
  employmentStatus           String?
  hasPets                    Boolean                    @default(false)
  monthlyIncome              Int?
  notes                      String?
  petDetails                 String?
  propertyId                 String?
  requestedMoveIn            DateTime?
  savingsBufferMonths        Int?
  status                     ApplicantStatus            @default(APPLIED)
  importExternalKey          String?
  importRawPayload           Json?
  importSource               String?
  importSubmittedAt          DateTime?
  screeningReason            String?
  screeningStatus            String?
  screeningSummary           String?
  screeningScore             Int?
  canProvideGuarantor        Boolean?
  guarantorRequired          Boolean                    @default(false)
  guarantorAvailable         Boolean?
  guarantorOutcome           GuarantorAssessmentStatus?
  guarantorNotes             String?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  property     Property?         @relation(fields: [propertyId], references: [id])
  referencing  ReferencingCheck?
  guarantors   Guarantor[]
  holdingDeposit HoldingDeposit?

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([deletedAt])
  @@index([screeningStatus])
  @@unique([userId, importExternalKey])
}

model ReferencingCheck {
  id                    String   @id @default(cuid())
  applicantId           String   @unique
  idProvided            Boolean  @default(false)
  rightToRentChecked    Boolean  @default(false)
  payslipsProvided      Boolean  @default(false)
  bankStatementsProvided Boolean @default(false)
  employmentReference   Boolean  @default(false)
  landlordReference     Boolean  @default(false)
  creditCheckPassed     Boolean?
  incomeVerified        Boolean  @default(false)
  guarantorRequired     Boolean  @default(false)
  guarantorProvided     Boolean  @default(false)
  petInsuranceProvided  Boolean  @default(false)
  score                 Int?
  decision              String?
  manualDecision        String?
  manualDecisionReason  String?
  risks                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ActionOverride {
  id          String    @id @default(cuid())
  userId      String
  key         String
  note        String?
  snoozedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

enum ComplianceType {
  GAS
  EICR
  EPC
}

enum NoticeType {
  SECTION_8
  SECTION_21
  RENT_INCREASE
  OTHER
}

enum NoticeMethod {
  EMAIL
  POST
  HAND_DELIVERED
  OTHER
}

enum ContactType {
  CALL
  EMAIL
  SMS
  VISIT
  NOTE
}

enum ApplicantStatus {
  APPLIED
  REFERENCING
  APPROVED
  DECLINED
  REJECTED
  MORE_INFO_REQUESTED
  WITHDRAWN
  HOLDING_DEPOSIT_PENDING
  RESERVED
  HOLDING_DEPOSIT_EXPIRED
}

enum ExpenseCategory {
  REPAIRS
  MAINTENANCE
  INSURANCE
  UTILITIES
  MORTGAGE_INTEREST
  SERVICE_CHARGE
  MANAGEMENT
  FEES
  OTHER
}

enum UserRole {
  USER
  ADMIN
}

enum RentFrequency {
  WEEKLY
  MONTHLY
}

model ReportSchedule {
  id             String     @id @default(cuid())
  type           ReportType
  propertyId     String?
  property       Property?  @relation(fields: [propertyId], references: [id])
  isActive       Boolean    @default(true)
  autoGenerate   Boolean    @default(true)
  reminderEnabled Boolean   @default(true)
  daysBeforeDue  Int        @default(7)
  reminderDays   String     @default("14,7,3,1")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ReportRun {
  id          String        @id @default(cuid())
  type        ReportType
  propertyId  String?
  property    Property?     @relation(fields: [propertyId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  dueDate     DateTime
  status      ReportStatus  @default(DRAFT)
  generatedBy String
  generatedAt DateTime      @default(now())
  finalisedAt DateTime?
  snapshots   ReportSnapshot[]
}

model ReportSnapshot {
  id          String   @id @default(cuid())
  reportRunId String
  reportRun   ReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  summaryJson Json
  rowsJson    Json
  warningsJson Json
  createdAt   DateTime @default(now())
}

model Guarantor {
  id                    String                     @id @default(cuid())
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  firstName             String
  lastName              String
  fullName              String?
  email                 String?
  phone                 String?
  annualIncomePence     Int?
  dateOfBirth           DateTime?
  relationshipToApplicant String?
  address1              String?
  address2              String?
  city                  String?
  postcode              String?
  employmentStatus      String?
  employerName          String?
  jobTitle              String?
  notes                 String?
  deedSigned            Boolean                    @default(false)
  deedSignedAt          DateTime?
  assessmentScore       Int?
  assessmentSummary     String?
  assessmentStatus      GuarantorAssessmentStatus  @default(PENDING)
  archivedAt            DateTime?
  applicantId           String?

  applicant Applicant? @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  @@index([applicantId])
  @@index([archivedAt])
}

model HoldingDeposit {
  id                    String                  @id @default(cuid())
  applicantId           String                  @unique
  propertyId            String?
  amountRequestedPence  Int
  amountReceivedPence   Int?
  weeklyRentSnapshotPence Int?
  receivedAt            DateTime?
  deadlineAt            DateTime?
  status                HoldingDepositStatus    @default(PENDING)
  outcomeReason         String?
  refundedAt            DateTime?
  retainedAt            DateTime?
  appliedAt             DateTime?
  appliedTo             HoldingDepositAppliedTo?
  consentToApply        Boolean                 @default(false)
  tenancySignedConfirmed Boolean                @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([applicantId, status])
  @@index([propertyId, status])
  @@index([deadlineAt])
}

enum HoldingDepositStatus {
  PENDING
  RECEIVED
  REFUNDED
  RETAINED
  APPLIED
  EXPIRED
  CANCELLED
}

enum HoldingDepositAppliedTo {
  FIRST_RENT
  TENANCY_DEPOSIT
}

enum ReportType {
  ANNUAL
  QUARTERLY
}

enum ReportStatus {
  DRAFT
  NEEDS_REVIEW
  READY
  EXPORTED
}

enum CheckStatus {
  PENDING
  PASSED
  FAILED
  NOT_REQUIRED
}

enum GuarantorAssessmentStatus {
  PENDING
  PASSED
  CONDITIONAL
  FAILED
  WITHDRAWN
}

enum GuaranteeScope {
  RENT_ONLY
  RENT_AND_DAMAGE
  ALL_TENANCY_OBLIGATIONS
}

enum GuarantorDocumentType {
  ID
  PROOF_OF_ADDRESS
  INCOME_PROOF
  BANK_STATEMENT
  CREDIT_REPORT
  SIGNED_GUARANTEE
  OTHER
}